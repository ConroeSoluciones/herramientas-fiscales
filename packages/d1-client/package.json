{
  "name": "@cs-herramientas/d1-client",
  "version": "0.1.0",
  "private": true,
  "description": "Tipos y cliente HTTP para Cloudflare D1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test dist/test/*.test.js"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  }
}
