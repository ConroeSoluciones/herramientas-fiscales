{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cs-herramientas",
  "compatibility_date": "2026-11-18",
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cs-herramientas",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
}
